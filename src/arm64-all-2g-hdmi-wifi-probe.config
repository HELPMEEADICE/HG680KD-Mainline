CONFIG_LOCALVERSION="-hg680kd-arm64-all-2g-hdmi-wifi-probe"
CONFIG_CMDLINE="console=tty0 console=ttyAMA0,115200n8 earlycon=pl011,mmio32,0xf8b00000 ignore_loglevel clk_ignore_unused blkdevparts=mmcblk0:1200M@0xd400000(system)ro,400M@0x8a400000(vendor)ro"
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
