#include "hi3798mv320-fiberhome-hg680kd-arm64.dts"

/ {
	model = "FiberHome HG680KD (ARM64)";

	memory@0 {
		reg = <0x0 0x00000000 0x0 0x80000000>;
	};

	reserved-memory {
		atf@8000000 {
			reg = <0x0 0x08000000 0x0 0x00400000>;
			no-map;
		};

		uboot-resmem-low@17ff8000 {
			reg = <0x0 0x17ff8000 0x0 0x00008000>;
			no-map;
		};

		uboot-resmem-high@7f67f000 {
			reg = <0x0 0x7f67f000 0x0 0x00981000>;
			no-map;
		};
	};

	emmc_clock: clock-52000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <52000000>;
	};
};

&{/soc} {
	peri: syscon@f8a20000 {
		compatible = "hisilicon,hi3798mv320-peri", "syscon";
		reg = <0x0 0xf8a20000 0x0 0x874>;
	};

	crg: syscon@f8a22000 {
		compatible = "hisilicon,hi3798mv320-crg", "syscon";
		reg = <0x0 0xf8a22000 0x0 0x400>;
		#clock-cells = <1>;
		#reset-cells = <2>;
	};

	gpu: gpu@f9200000 {
		compatible = "arm,mali-450";
		reg = <0x0 0xf9200000 0x0 0x40000>;
		interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0",
				  "pp1", "ppmmu1", "pmu", "pp";
		clocks = <&crg 0>, <&crg 1>;
		clock-names = "bus", "core";
		resets = <&crg 0xd4 4>;
	};

	mmc@f9830000 {
		compatible = "hisilicon,hi3798mv320-emmc";
		reg = <0x0 0xf9830000 0x0 0x1000>;
		interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&emmc_clock>;
		hisilicon,crg = <&crg>;
		non-removable;
		cap-mmc-highspeed;
		cap-mmc-hw-reset;
		no-sd;
		no-sdio;
		bus-width = <8>;
		max-frequency = <52000000>;
	};

	ethernet@f9840000 {
		compatible = "hisilicon,hi3798mv320-gmac";
		reg = <0x0 0xf9840000 0x0 0x1000>,
		      <0x0 0xf984300c 0x0 0x4>;
		interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
		resets = <&crg 0x3bc 0>, <&crg 0x0d0 0>;
		reset-names = "mac_core", "mac_ifc";
		phy-mode = "mii";
		phy-handle = <&phy1>;
		#address-cells = <1>;
		#size-cells = <0>;

		phy1: ethernet-phy@1 {
			reg = <1>;
		};
	};

	usb@f98a0000 {
		compatible = "hisilicon,hi3798mv320-xhci";
		reg = <0x0 0xf98a0000 0x0 0x10000>,
		      <0x0 0xf9866000 0x0 0x1000>,
		      <0x0 0xf9960000 0x0 0x1000>,
		      <0x0 0xf8ab0118 0x0 0x4>;
		reg-names = "xhci", "phy0", "phy1", "trim";
		interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
		hisilicon,crg = <&crg>;
		hisilicon,peri = <&peri>;
		usb2-lpm-disable;
	};
};
