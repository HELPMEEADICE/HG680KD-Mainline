CONFIG_LOCALVERSION="-hg680kd-arm64-all-2g-hdmi"
CONFIG_CMDLINE="console=tty0 console=ttyAMA0,115200n8 earlycon=pl011,mmio32,0xf8b00000 ignore_loglevel clk_ignore_unused"
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
