--- a/drivers/media/platform/Kconfig
+++ b/drivers/media/platform/Kconfig
@@ -64 +64,11 @@ config VIDEO_HI3798MV320_JPGD
+config VIDEO_HI3798MV320_VENC
+	bool "HiSilicon Hi3798MV320 H.264 video encoder"
+	depends on ARM64 && OF && COMMON_CLK_HI3798MV320_RESET=y
+	depends on V4L_MEM2MEM_DRIVERS && VIDEO_DEV=y
+	select V4L2_MEM2MEM_DEV
+	select VIDEOBUF2_DMA_CONTIG
+	help
+	  Encode NV12 and NV21 frames as H.264 using the Hi3798MV320 VEDU
+	  through a V4L2 memory-to-memory video device.
+
 # Ancillary drivers
--- a/drivers/media/platform/Makefile
+++ b/drivers/media/platform/Makefile
@@ -46,3 +46,4 @@ obj-$(CONFIG_VIDEO_HI3798MV320_VDEC)	+= hi3798mv320-vdec.o
 hi3798mv320-vdec-y			:= hi3798mv320-vdec-core.o
 hi3798mv320-vdec-$(CONFIG_KERNEL_MODE_NEON)	+= hi3798mv320-vdec-neon.o
 obj-$(CONFIG_VIDEO_HI3798MV320_JPGD)	+= hi3798mv320-jpgd.o
+obj-$(CONFIG_VIDEO_HI3798MV320_VENC)	+= hi3798mv320-venc.o
