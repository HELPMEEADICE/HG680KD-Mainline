 static int modeset_open(struct inode *inode, struct file *file)
 {
 	return single_open(file, report, inode->i_private);
+}
+
+static int set_receiver_tags(struct modeset *test, void __iomem *packets, unsigned int marker_base)
+{
+	bool enable = marker_base;
+	struct hdmi_drm_infoframe frame;
+	u8 data[31] = {};
+	unsigned int i;
+	int ret;
+
+	if (!test->mode || !(readl(test->aon + 0x28) & BIT(0)))
+		return -ENOLINK;
+
+	if (enable) {
+		hdmi_drm_infoframe_init(&frame);
+		frame.eotf = HDMI_EOTF_TRADITIONAL_GAMMA_SDR;
+		frame.max_cll = marker_base + test->mode->vic;
+		ret = hdmi_drm_infoframe_pack(&frame, data, sizeof(data));
+		if (ret < 0)
+			return ret;
+		writel(get_unaligned_le24(data), packets + PKT_DRM_HEADER);
+		for (i = 0; i < 4; i++) {
+			const u8 *slot = data + 3 + i * 7;
+
+			writel(get_unaligned_le32(slot), packets + PKT_DRM_HEADER + 4 + i * 8);
+			writel(get_unaligned_le24(slot + 4), packets + PKT_DRM_HEADER + 8 + i * 8);
+		}
+	}
+
+	/* Both pixel packing and TMDS clock remain at 8 bpc. */
+	update(packets, PKT_LINK_MODE, PKT_DEPTH_ENABLE, enable ? PKT_DEPTH_ENABLE : 0);
+	update(packets, PKT_HDR_ENABLE, GENMASK(1, 0), enable ? 3 : 0);
+	test->receiver_tags = enable;
+	return 0;
 }
 
