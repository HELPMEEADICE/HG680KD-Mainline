+static void lock_sample(struct modeset *test, struct lock_sample *sample)
+{
+	regmap_read(test->crg, CRG_PLL_LOCK, &sample->crg);
+	sample->analog = readl(test->phy + APHY_STATUS0);
+	sample->detector = readl(test->phy + PHY_LOCK_STATUS);
+}
+
+static int trace_hpll(struct modeset *test)
+{
+	struct regmap *crg = test->crg;
+	u32 orig, value;
+	u64 started;
+	int ret, restore;
+
+	ret = regmap_read(crg, HPLL_CTRL1, &orig);
+	if (ret)
+		return ret;
+	if (orig & HPLL_PD)
+		return -EIO;
+	ret = regmap_read(crg, CRG_PLL_LOCK, &test->hpll_on);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(crg, HPLL_CTRL1, HPLL_PD, HPLL_PD);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(crg, CRG_PLL_LOCK, value,
+				       ((value ^ test->hpll_on) & CRG_PLL_LOCKS),
+				       10, 3000);
+	test->hpll_off = value;
+	test->hpll_mask = (test->hpll_on ^ test->hpll_off) & CRG_PLL_LOCKS;
+	started = ktime_get_ns();
+	restore = regmap_update_bits(crg, HPLL_CTRL1, HPLL_PD, orig);
+	if (restore)
+		return restore;
+	restore = regmap_read_poll_timeout(crg, CRG_PLL_LOCK, value,
+					   !((value ^ test->hpll_on) & CRG_PLL_LOCKS),
+					   5, 20000);
+	test->hpll_restored = value;
+	test->hpll_lock_ns = ktime_get_ns() - started;
+	if (restore)
+		return restore;
+	if (ret || !is_power_of_2(test->hpll_mask) ||
+	    !(test->hpll_on & test->hpll_mask) || (test->hpll_off & test->hpll_mask))
+		return -EIO;
+	return 0;
+}
